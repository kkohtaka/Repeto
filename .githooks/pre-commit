#!/usr/bin/env bash
#
# Repeto pre-commit hook — runs UX/design guardrail checks on staged changes,
# then verifies the CI/release workflows still share one Xcode toolchain.
# Enable with: git config core.hooksPath .githooks  (or run scripts/setup-hooks.sh)
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/guardrails-check.sh" --staged
exec "$repo_root/scripts/check-workflow-toolchain.sh"
